# Copy to .env (docker compose reads it) and to src/TicketDeskPro.Api/appsettings.Development.json
# via user-secrets or environment variables. NEVER commit real values.

# --- Database ---
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=TicketDesk;Username=postgres;Password=CHANGE_ME

# --- Auth (Phase 2) ---
# At least 32 characters. Generate with: openssl rand -hex 32
JwtSettings__Secret=YOUR_SUPER_SECRET_KEY_AT_LEAST_32_CHARS
JwtSettings__Issuer=TicketDeskPro
JwtSettings__Audience=TicketDeskProClient
JwtSettings__AccessTokenMinutes=15
JwtSettings__RefreshTokenDays=7

# --- Redis (Phase 5) ---
RedisSettings__ConnectionString=localhost:6379

# --- CORS ---
FRONTEND_URL=http://localhost:3000

# --- Email via Outbox (Phase 4) ---
# Brevo HTTPS API (port 443). SMTP ports 25/465/587 are blocked on Render's free
# tier since Sep 2025, so the sender uses the API instead of SmtpClient.
# Get the key at Brevo → Settings → SMTP & API → API keys; verify FromAddress
# as a sender (Brevo sends a confirmation email — no domain needed).
EmailSettings__ApiKey=key_xxxxx
EmailSettings__FromAddress=your verified email
EmailSettings__FromName=TicketDesk Pro

# --- Attachments (optional; local disk when unset) ---
# Cloudinary free tier (25 GB) — Render's free disk is ephemeral, so files
# stored locally vanish on every redeploy. Set these to store on Cloudinary
# instead (Dashboard → API Keys; uploads are signed server-side).
# Cloudinary__CloudName=your-cloud-name
# Cloudinary__ApiKey=your-api-key
# Cloudinary__ApiSecret=your-api-secret

# --- Logging (Phase 8 containers: point at a mounted volume) ---
# Serilog__WriteTo__1__Args__path=/data/logs/log-.txt

# ============================================================
# Production (Render) — set these in the service's Environment tab
# ============================================================

# Neon Postgres (pooled endpoint, SSL required):
# ConnectionStrings__DefaultConnection=Host=ep-xxx-xxxx.aws.neon.tech;Port=5432;Database=neondb;Username=neondb_owner;Password=xxx;Ssl Mode=Require;Trust Server Certificate=true

# Upstash Redis (TLS — the connection string carries ssl+password):
# RedisSettings__ConnectionString=xxx.upstash.io:6379,ssl=true,password=xxx

# Exact origin of the Vercel frontend (no trailing slash):
# FRONTEND_URL=https://your-app.vercel.app

# Opt-in demo users (superadmin/admin/agent/customer @ticketdesk.dev, Admin123!).
# Leave unset for a private production instance:
# SeedDemoUsers=true

# Attachment root inside the container (Render free = ephemeral disk; files
# survive restarts but not redeploys — see deployment guide ceiling note):
# Storage__RootPath=/app/uploads
