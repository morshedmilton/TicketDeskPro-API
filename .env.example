# Copy to .env (docker compose reads it) and to src/TicketDeskPro.Api/appsettings.Development.json
# via user-secrets or environment variables. NEVER commit real values.

# --- Database ---
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=TicketDesk;Username=postgres;Password=CHANGE_ME

# --- Auth (Phase 2) ---
# At least 32 characters. Generate with: openssl rand -hex 32
JwtSettings__Secret=YOUR_SUPER_SECRET_KEY_AT_LEAST_32_CHARS
JwtSettings__Issuer=TicketDeskPro
JwtSettings__Audience=TicketDeskProClient
JwtSettings__AccessTokenMinutes=15
JwtSettings__RefreshTokenDays=7

# --- Redis (Phase 5) ---
RedisSettings__ConnectionString=localhost:6379

# --- CORS ---
FRONTEND_URL=http://localhost:3000

# --- Email via Outbox (Phase 4) ---
SmtpSettings__Host=smtp.resend.com
SmtpSettings__Port=587
SmtpSettings__Username=resend
SmtpSettings__Password=re_xxxxx
