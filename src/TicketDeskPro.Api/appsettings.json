{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=TicketDesk;Username=postgres;Password=postgres"
  },
  "JwtSettings": {
    "Secret": "",
    "Issuer": "TicketDeskPro",
    "Audience": "TicketDeskProClient",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "RedisSettings": {
    "ConnectionString": "localhost:6379"
  },
  "SmtpSettings": {
    "Host": "",
    "Port": 587,
    "Username": "",
    "Password": "",
    "UseSsl": true,
    "FromAddress": "no-reply@ticketdesk.dev",
    "FromName": "TicketDesk Pro"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] ({CorrelationId}) {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
